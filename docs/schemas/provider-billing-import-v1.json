{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blisspixel/deepr/docs/schemas/provider-billing-import-v1.json",
  "title": "Deepr Provider Billing Import v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "provider", "billing_scope", "statement", "lines"],
  "properties": {
    "schema_version": {"const": "deepr-provider-billing-import-v1"},
    "kind": {"const": "deepr.costs.provider_billing_import"},
    "provider": {"$ref": "#/$defs/id"},
    "billing_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_ref"],
      "properties": {
        "scope_ref": {"$ref": "#/$defs/id"},
        "account_id": {"$ref": "#/$defs/optionalId"},
        "organization_id": {"$ref": "#/$defs/optionalId"},
        "project_id": {"$ref": "#/$defs/optionalId"},
        "workspace_id": {"$ref": "#/$defs/optionalId"},
        "subscription_id": {"$ref": "#/$defs/optionalId"},
        "credential_fingerprint": {
          "oneOf": [
            {"const": ""},
            {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          ]
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_id", "status", "complete", "period_start", "period_end",
        "currency", "source_posture", "net_total_usd"
      ],
      "properties": {
        "statement_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["final", "provisional"]},
        "complete": {"type": "boolean"},
        "period_start": {"$ref": "#/$defs/timestamp"},
        "period_end": {"$ref": "#/$defs/timestamp"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "source_posture": {"enum": ["operator_normalized", "provider_export", "provider_api"]},
        "net_total_usd": {"$ref": "#/$defs/money"}
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/line"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,199}$"},
    "optionalId": {
      "oneOf": [
        {"const": ""},
        {"$ref": "#/$defs/id"}
      ]
    },
    "timestamp": {"type": "string", "format": "date-time", "maxLength": 40},
    "money": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]{0,8})(?:\\.[0-9]{1,6})?$"},
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id", "category", "capacity_class", "usage_start", "usage_end",
        "charge_usd", "credit_usd", "adjustment_usd", "tax_usd", "net_usd"
      ],
      "properties": {
        "line_id": {"$ref": "#/$defs/id"},
        "category": {"enum": ["metered_api", "tool", "storage", "cache", "tax", "credit", "adjustment", "other"]},
        "capacity_class": {"enum": ["api_metered", "prepaid_plan", "owned_local", "unknown"]},
        "usage_start": {"$ref": "#/$defs/timestamp"},
        "usage_end": {"$ref": "#/$defs/timestamp"},
        "charge_usd": {"$ref": "#/$defs/money"},
        "credit_usd": {"$ref": "#/$defs/money"},
        "adjustment_usd": {"$ref": "#/$defs/money"},
        "tax_usd": {"$ref": "#/$defs/money"},
        "net_usd": {"$ref": "#/$defs/money"},
        "model": {"$ref": "#/$defs/optionalId"},
        "sku": {"$ref": "#/$defs/optionalId"},
        "pricing_tier": {"$ref": "#/$defs/optionalId"},
        "provider_http_request_id": {"$ref": "#/$defs/optionalId"},
        "provider_object_id": {"$ref": "#/$defs/optionalId"},
        "provider_job_id": {"$ref": "#/$defs/optionalId"},
        "provider_request_id": {"$ref": "#/$defs/optionalId"},
        "client_correlation_id": {"$ref": "#/$defs/optionalId"}
      }
    }
  }
}
