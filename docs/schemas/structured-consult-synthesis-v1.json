{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blisspixel/deepr/docs/schemas/structured-consult-synthesis-v1.json",
  "title": "Deepr Structured Consult Synthesis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "graph_id", "node_id", "depends_on", "position_artifact_ids", "model",
    "status", "attempt", "started_at", "completed_at", "usage", "cost_usd", "answer", "agreements",
    "disagreements", "uncertainty", "next_tests", "contract", "artifact_id", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "deepr-structured-consult-synthesis-v1"},
    "kind": {"const": "deepr.eval.structured_consult_synthesis"},
    "graph_id": {"type": "string", "pattern": "^graph_[a-f0-9]{24}$"},
    "node_id": {"const": "synthesis_001"},
    "depends_on": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string"}},
    "position_artifact_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^artifact_[a-f0-9]{24}$"}},
    "model": {"type": "string", "minLength": 1},
    "status": {"const": "completed"},
    "attempt": {"const": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "context_bytes", "input_tokens_reserved", "output_tokens_reserved", "reported_input_tokens",
        "reported_output_tokens", "request_id", "stop_reason", "dispatched", "transport_attempts",
        "usage_ambiguous", "cost_usd"
      ],
      "properties": {
        "context_bytes": {"type": "integer", "minimum": 0},
        "input_tokens_reserved": {"type": "integer", "minimum": 0},
        "output_tokens_reserved": {"type": "integer", "minimum": 0},
        "reported_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reported_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "request_id": {"type": "string"}, "stop_reason": {"type": "string"},
        "dispatched": {"const": true}, "transport_attempts": {"const": 1},
        "usage_ambiguous": {"type": "boolean"}, "cost_usd": {"const": 0.0}
      }
    },
    "cost_usd": {"const": 0.0},
    "answer": {"type": "string", "minLength": 1, "maxLength": 16384},
    "agreements": {"$ref": "#/$defs/stringList"},
    "disagreements": {"$ref": "#/$defs/stringList"},
    "uncertainty": {"type": "string", "minLength": 1, "maxLength": 16384},
    "next_tests": {"$ref": "#/$defs/stringList"},
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "read_only", "semantic_quality_reviewed", "agreement_is_not_verification", "writes_state",
        "observability_writes", "cost_ledger_required"
      ],
      "properties": {
        "read_only": {"const": true}, "semantic_quality_reviewed": {"const": false},
        "agreement_is_not_verification": {"const": true}, "writes_state": {"const": false},
        "observability_writes": {"const": true}, "cost_ledger_required": {"const": true}
      }
    },
    "artifact_id": {"type": "string", "pattern": "^artifact_[a-f0-9]{24}$"},
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "stringList": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 16384}}
  }
}
